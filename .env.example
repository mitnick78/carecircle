# Copy to .env and replace every "change-me". Never commit .env.
# These values only target the local Docker databases (docker-compose.yml).

# Development database (postgres-dev)
DEV_DB_USER=change-me
DEV_DB_PASSWORD=change-me
DEV_DB_NAME=carecircle_dev

# Test database (postgres-test) — different credentials from development
TEST_DB_USER=change-me
TEST_DB_PASSWORD=change-me
TEST_DB_NAME=carecircle_test

# Connection URLs used by the API (must match the values above)
DATABASE_URL=postgresql://change-me:change-me@localhost:5432/carecircle_dev
DATABASE_URL_TEST=postgresql://change-me:change-me@localhost:5433/carecircle_test

# API
API_PORT=3001

# Clients
NEXT_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_API_URL=http://localhost:3001
